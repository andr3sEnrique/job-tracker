// Data model — see docs/PLAN_TECNICO.md §4.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  runtime             = "nodejs"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum ApplicationStatus {
  APPLIED
  SCREENING
  INTERVIEWING
  OFFER
  ACCEPTED
  REJECTED
  WITHDRAWN
  GHOSTED
}

enum ApplicationSource {
  LINKEDIN
  INDEED
  INFOJOBS
  COMPANY_SITE
  REFERRAL
  RECRUITER
  OTHER
}

enum WorkMode {
  REMOTE
  HYBRID
  ONSITE
  UNKNOWN
}

enum SalaryPeriod {
  YEAR
  MONTH
  HOUR
}

enum ApplicationOrigin {
  EMAIL
  MANUAL
}

enum EventType {
  APPLIED
  CONFIRMATION_RECEIVED
  RECRUITER_CONTACT
  INTERVIEW_SCHEDULED
  TECHNICAL_INTERVIEW_SCHEDULED
  OFFER_RECEIVED
  REJECTED
  WITHDRAWN
  STATUS_CHANGED
  NOTE
}

enum EventSource {
  EMAIL
  MANUAL
  SYSTEM
}

enum GmailConnectionStatus {
  ACTIVE
  NEEDS_REAUTH
  REVOKED
  ERROR
}

enum SyncRunType {
  INITIAL
  INCREMENTAL
  MANUAL
  FALLBACK
  /// Full-window re-scan after the prefilter rules changed.
  RESCAN
}

/// Who started a sync: the user (button), the in-process scheduler or an external cron.
enum SyncTrigger {
  USER
  SCHEDULER
  CRON
}

enum SyncRunStatus {
  RUNNING
  SUCCESS
  PARTIAL
  FAILED
}

enum EmailCategory {
  APPLICATION_SUBMITTED
  APPLICATION_CONFIRMATION
  RECRUITER_REPLY
  INTERVIEW
  TECHNICAL_INTERVIEW
  REJECTION
  OFFER
  JOB_ALERT
  IRRELEVANT
  UNKNOWN
}

enum EmailProcessingStatus {
  PENDING
  PROCESSED
  SKIPPED
  NEEDS_REVIEW
  FAILED
}

model User {
  id          String    @id @default(uuid(7)) @db.Uuid
  /// Stable Google account id. Null until the user logs in with Google (Phase 3).
  googleSub   String?   @unique @map("google_sub")
  email       String    @unique
  name        String?
  avatarUrl   String?   @map("avatar_url")
  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions         Session[]
  gmailConnections GmailConnection[]
  companies        Company[]
  applications Application[]

  @@map("users")
}

/// Server-side sessions: the cookie holds a random token, the DB only its SHA-256 hash,
/// so a leaked database cannot be replayed as cookies. Revocable by deleting the row.
model Session {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  tokenHash  String   @unique @map("token_hash")
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Company {
  id             String   @id @default(uuid(7)) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  name           String
  /// Lowercase, accent-free, without legal suffixes ("S.L.", "Inc"…). Used for matching.
  normalizedName String   @map("normalized_name")
  domain         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  applications Application[]

  @@unique([userId, normalizedName])
  @@index([userId, domain])
  @@map("companies")
}

model Application {
  id             String            @id @default(uuid(7)) @db.Uuid
  userId         String            @map("user_id") @db.Uuid
  companyId      String            @map("company_id") @db.Uuid
  roleTitle      String            @map("role_title")
  location       String?
  workMode       WorkMode          @default(UNKNOWN) @map("work_mode")
  salaryMin      Int?              @map("salary_min")
  salaryMax      Int?              @map("salary_max")
  salaryCurrency String?           @map("salary_currency") @db.Char(3)
  salaryPeriod   SalaryPeriod?     @map("salary_period")
  source         ApplicationSource @default(OTHER)
  jobUrl         String?           @map("job_url")
  externalJobId  String?           @map("external_job_id")
  status         ApplicationStatus @default(APPLIED)
  appliedAt      DateTime          @map("applied_at") @db.Timestamptz(3)
  lastActivityAt DateTime          @map("last_activity_at") @db.Timestamptz(3)
  origin         ApplicationOrigin @default(MANUAL)
  needsReview    Boolean           @default(false) @map("needs_review")
  /// Fields edited by hand that automatic processing must not overwrite.
  lockedFields   String[]          @default([]) @map("locked_fields")
  notes          String?
  archived       Boolean           @default(false)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  events  ApplicationEvent[]
  threads EmailThread[]
  emails  Email[]

  @@index([userId, status])
  @@index([userId, appliedAt(sort: Desc)])
  @@index([userId, lastActivityAt(sort: Desc)])
  @@index([companyId])
  @@index([jobUrl])
  @@map("applications")
}

model ApplicationEvent {
  id            String             @id @default(uuid(7)) @db.Uuid
  applicationId String             @map("application_id") @db.Uuid
  type          EventType
  fromStatus    ApplicationStatus? @map("from_status")
  toStatus      ApplicationStatus? @map("to_status")
  /// When it happened (e.g. the email date), not when it was recorded.
  occurredAt    DateTime           @map("occurred_at") @db.Timestamptz(3)
  source        EventSource
  summary       String?
  metadata      Json?
  /// The email that produced this event. Unique: one email yields at most one event,
  /// so re-processing can never duplicate history.
  emailId       String?            @unique @map("email_id") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  email       Email?      @relation(fields: [emailId], references: [id], onDelete: SetNull)

  @@index([applicationId, occurredAt(sort: Desc)])
  @@index([occurredAt(sort: Desc)])
  @@map("application_events")
}

/// One authorised Gmail mailbox. The refresh token is encrypted (AES-256-GCM); access
/// tokens are short-lived and never stored.
model GmailConnection {
  id                     String                @id @default(uuid(7)) @db.Uuid
  userId                 String                @map("user_id") @db.Uuid
  googleEmail            String                @map("google_email")
  scopes                 String[]
  refreshTokenEnc        String                @map("refresh_token_enc")
  keyVersion             Int                   @map("key_version")
  status                 GmailConnectionStatus @default(ACTIVE)
  /// Gmail history cursor for incremental sync (Phase 6). Captured before the initial sync.
  lastHistoryId          String?               @map("last_history_id")
  lastSyncedAt           DateTime?             @map("last_synced_at") @db.Timestamptz(3)
  initialSyncCompletedAt DateTime?             @map("initial_sync_completed_at") @db.Timestamptz(3)
  /// Prefilter rules the stored mail was evaluated with; older → re-scan on next sync.
  prefilterVersion       Int                   @default(0) @map("prefilter_version")
  /// Lease that prevents two syncs (cron + manual) from running at the same time.
  syncLockedUntil        DateTime?             @map("sync_locked_until") @db.Timestamptz(3)
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncRuns SyncRun[]
  threads  EmailThread[]
  emails   Email[]

  @@unique([userId, googleEmail])
  @@map("gmail_connections")
}

model SyncRun {
  id             String        @id @default(uuid(7)) @db.Uuid
  connectionId   String        @map("connection_id") @db.Uuid
  type           SyncRunType
  trigger        SyncTrigger   @default(USER)
  status         SyncRunStatus @default(RUNNING)
  startedAt      DateTime      @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt     DateTime?     @map("finished_at") @db.Timestamptz(3)
  /// Checkpoint: where to resume a chunked initial sync.
  pageToken      String?       @map("page_token")
  messagesListed Int           @default(0) @map("messages_listed")
  candidates     Int           @default(0)
  skipped        Int           @default(0)
  failed         Int           @default(0)
  /// A code, never a raw provider message (it could contain personal data).
  errorCode      String?       @map("error_code")

  connection GmailConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@index([connectionId, startedAt(sort: Desc)])
  @@map("sync_runs")
}

model EmailThread {
  id             String    @id @default(uuid(7)) @db.Uuid
  connectionId   String    @map("connection_id") @db.Uuid
  gmailThreadId  String    @map("gmail_thread_id")
  /// The most reliable signal for matching follow-up emails to an application (Phase 5).
  applicationId  String?   @map("application_id") @db.Uuid
  firstMessageAt DateTime  @map("first_message_at") @db.Timestamptz(3)
  lastMessageAt  DateTime  @map("last_message_at") @db.Timestamptz(3)
  messageCount   Int       @default(0) @map("message_count")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  connection  GmailConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  application Application?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  emails      Email[]

  @@unique([connectionId, gmailThreadId])
  @@index([applicationId])
  @@map("email_threads")
}

/// Email METADATA only. Bodies, HTML, attachments and recipients are never stored:
/// Gmail stays the source of truth and messages can be re-fetched by id.
/// Rows discarded by the prefilter keep only ids and date (no sender, no subject).
model Email {
  id               String                @id @default(uuid(7)) @db.Uuid
  connectionId     String                @map("connection_id") @db.Uuid
  threadId         String                @map("thread_id") @db.Uuid
  /// Idempotency key: the same message is never stored or processed twice.
  gmailMessageId   String                @map("gmail_message_id")
  rfc822MessageId  String?               @map("rfc822_message_id")
  fromEmail        String?               @map("from_email")
  fromName         String?               @map("from_name")
  fromDomain       String?               @map("from_domain")
  subject          String?
  receivedAt       DateTime              @map("received_at") @db.Timestamptz(3)
  gmailLabels      String[]              @default([]) @map("gmail_labels")
  prefilterReason  String?               @map("prefilter_reason")
  category         EmailCategory?
  confidence       Float?
  classifier       String?
  extracted        Json?
  processingStatus EmailProcessingStatus @default(PENDING) @map("processing_status")
  attempts         Int                   @default(0)
  nextAttemptAt    DateTime?             @map("next_attempt_at") @db.Timestamptz(3)
  errorCode        String?               @map("error_code")
  applicationId    String?               @map("application_id") @db.Uuid
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  connection  GmailConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  thread      EmailThread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  application Application?      @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  event       ApplicationEvent?
  aiRuns      AiRun[]

  @@unique([connectionId, gmailMessageId])
  @@index([connectionId, processingStatus, nextAttemptAt])
  @@index([connectionId, receivedAt(sort: Desc)])
  @@index([fromDomain])
  @@index([applicationId])
  @@map("emails")
}

enum AiRunStatus {
  OK
  /// The model answered something that failed validation: rules were used instead.
  INVALID_OUTPUT
  ERROR
  /// Monthly budget reached: not called, rules were used.
  SKIPPED_BUDGET
}

/// One AI call (or skipped call). Audit, cost control and cache: a reprocessed email reuses
/// the stored output of the same model and prompt version instead of paying again.
/// Holds structured output only, never email text.
model AiRun {
  id            String      @id @default(uuid(7)) @db.Uuid
  /// Kept (null) when the email is deleted, so past spending still counts for the budget.
  emailId       String?     @map("email_id") @db.Uuid
  provider      String
  model         String
  promptVersion String      @map("prompt_version")
  status        AiRunStatus
  inputTokens   Int         @default(0) @map("input_tokens")
  outputTokens  Int         @default(0) @map("output_tokens")
  latencyMs     Int         @default(0) @map("latency_ms")
  costUsd       Decimal     @default(0) @map("cost_usd") @db.Decimal(10, 6)
  output        Json?
  errorCode     String?     @map("error_code")
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  email Email? @relation(fields: [emailId], references: [id], onDelete: SetNull)

  @@index([emailId])
  @@index([createdAt])
  @@map("ai_runs")
}
