# Copy to .env (repo root) — never commit real values.
# Everything except the Google/allowlist block has a local default.

# --- Authentication (required to log in; see docs/setup-google-cloud.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated. Only these Google accounts can sign in; checked on every request.
ALLOWED_GOOGLE_EMAILS=
# Signs the OAuth state cookie. Required in production (min 32 chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# COOKIE_SECRET=
# SESSION_TTL_DAYS=30
# AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Gmail (Phase 4) ---
# AES-256-GCM key for Gmail refresh tokens. Required in production: openssl rand -base64 32
# TOKEN_ENCRYPTION_KEY=
# `fake` serves 240 synthetic emails: develop without touching your real mailbox.
# MAIL_PROVIDER=gmail
# GMAIL_INITIAL_SYNC_DAYS=180
# SYNC_PAGE_SIZE=100
# SYNC_TIME_BUDGET_MS=20000

# --- Automatic sync (Phase 6) ---
# Secret for POST /api/v1/internal/sync (external cron). Unset = endpoint disabled.
#   openssl rand -base64 32
# CRON_SECRET=
# In-process timer, for an always-on host or local development (free hosts sleep: use the cron).
# SCHEDULER_ENABLED=false
# SYNC_INTERVAL_MINUTES=15
# APPLIED/SCREENING applications without activity for this long become GHOSTED.
# GHOSTED_AFTER_DAYS=30

# --- API ---
# DATABASE_URL=postgresql://jat:jat@localhost:5432/job_tracker   # docker-compose default
# FRONTEND_URL=http://localhost:3000   # public origin of the web app (https in production)
# PORT=4000
# LOG_LEVEL=info
# Seed data goes to this account (defaults to the first ALLOWED_GOOGLE_EMAILS entry).
# SEED_USER_EMAIL=

# --- Web ---
# Where the Next.js server proxies /api/* to.
# API_INTERNAL_URL=http://localhost:4000
# `mock` runs the UI on in-memory sample data, without the API or login.
# NEXT_PUBLIC_API_MODE=http
