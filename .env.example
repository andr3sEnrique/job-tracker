# Copy to .env (repo root) — never commit real values.
# Everything except the Google/allowlist block has a local default.

# --- Authentication (required to log in; see docs/setup-google-cloud.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated. Only these Google accounts can sign in; checked on every request.
ALLOWED_GOOGLE_EMAILS=
# Signs the OAuth state cookie. Required in production (min 32 chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# COOKIE_SECRET=
# SESSION_TTL_DAYS=30
# AUTH_RATE_LIMIT_PER_MINUTE=10

# --- API ---
# DATABASE_URL=postgresql://jat:jat@localhost:5432/job_tracker   # docker-compose default
# FRONTEND_URL=http://localhost:3000   # public origin of the web app (https in production)
# PORT=4000
# LOG_LEVEL=info
# Seed data goes to this account (defaults to the first ALLOWED_GOOGLE_EMAILS entry).
# SEED_USER_EMAIL=

# --- Web ---
# Where the Next.js server proxies /api/* to.
# API_INTERNAL_URL=http://localhost:4000
# `mock` runs the UI on in-memory sample data, without the API or login.
# NEXT_PUBLIC_API_MODE=http
