# Copy to .env (repo root) — never commit real values.
# Everything except the Google/allowlist block has a local default.

# --- Authentication (required to log in; see docs/setup-google-cloud.md) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated. Only these Google accounts can sign in; checked on every request.
ALLOWED_GOOGLE_EMAILS=
# Signs the OAuth state cookie. Required in production (min 32 chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# COOKIE_SECRET=
# SESSION_TTL_DAYS=30
# AUTH_RATE_LIMIT_PER_MINUTE=10
# SYNC_RATE_LIMIT_PER_MINUTE=30   # sync, cron and reprocess

# --- Gmail (Phase 4) ---
# AES-256-GCM key for Gmail refresh tokens. Required in production: openssl rand -base64 32
# TOKEN_ENCRYPTION_KEY=
# `fake` serves 240 synthetic emails: develop without touching your real mailbox.
# MAIL_PROVIDER=gmail
# GMAIL_INITIAL_SYNC_DAYS=180
# SYNC_PAGE_SIZE=100
# SYNC_TIME_BUDGET_MS=20000

# --- Automatic sync (Phase 6) ---
# Secret for POST /api/v1/internal/sync (external cron). Unset = endpoint disabled.
#   openssl rand -base64 32
# CRON_SECRET=
# In-process timer, for an always-on host or local development (free hosts sleep: use the cron).
# SCHEDULER_ENABLED=false
# SYNC_INTERVAL_MINUTES=15
# APPLIED/SCREENING applications without activity for this long become GHOSTED.
# GHOSTED_AFTER_DAYS=30

# --- AI (Phase 7) ---
# Second opinion only for emails the rules are unsure about. `none` keeps everything local.
# `anthropic` sends subject, sender domain and a redacted, truncated body (no addresses or
# phone numbers) to the Anthropic API, which does not train on API data by default.
# AI_PROVIDER=none            # none | anthropic | ollama
# AI_MODEL=                   # defaults: claude-haiku-4-5 / llama3.1:8b
# ANTHROPIC_API_KEY=
# OLLAMA_URL=http://localhost:11434
# AI_CONFIDENCE_THRESHOLD=0.8 # rules below this (or missing company/role) ask the AI
# AI_MONTHLY_BUDGET_USD=1     # circuit breaker: rules only once reached
# AI_INPUT_USD_PER_MTOK=1     # prices for the budget (Claude Haiku 4.5)
# AI_OUTPUT_USD_PER_MTOK=5

# --- API ---
# DATABASE_URL=postgresql://jat:jat@localhost:5432/job_tracker   # docker-compose default
# Neon: DATABASE_URL is the pooled URL; migrations use the direct one (see docs/deploy.md).
# DIRECT_URL=
# FRONTEND_URL=http://localhost:3000   # public origin of the web app (https in production)
# PORT=4000
# LOG_LEVEL=info
# Seed data goes to this account (defaults to the first ALLOWED_GOOGLE_EMAILS entry).
# SEED_USER_EMAIL=

# --- Web ---
# Where the Next.js server proxies /api/* to.
# API_INTERNAL_URL=http://localhost:4000
# `mock` runs the UI on in-memory sample data, without the API or login.
# NEXT_PUBLIC_API_MODE=http
# Contact address shown on the public /privacy page (optional).
# NEXT_PUBLIC_CONTACT_EMAIL=
