# Copy to .env — never commit real values.
# Every variable has a local default, so `pnpm dev` works without a .env.

# --- API ---
# DATABASE_URL=postgresql://jat:jat@localhost:5432/job_tracker   # docker-compose default
# PORT=4000
# LOG_LEVEL=info
# Temporary until Phase 3 (Google OAuth): every request acts as this user.
# OWNER_EMAIL=owner@example.com

# --- Web ---
# Where the Next.js server proxies /api/* to.
# API_INTERNAL_URL=http://localhost:4000
# `mock` runs the UI on in-memory sample data, without the API.
# NEXT_PUBLIC_API_MODE=http
